# =====================================================================
# NEXORA REAL ESTATE CRM SAAS — ENVIRONMENT VARIABLES
# =====================================================================

# Environment mode ('development' or 'production')
ENVIRONMENT=development

# Application Security
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# In local development without Docker, defaults to SQLite: sqlite:///./crm.db
# In Docker or production with PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crm_db

# AI & Voice Providers
# Set AI_PROVIDER to 'mock' for 100% offline local development without paid keys.
# Or set to 'openai' / 'groq' when credentials are provided.
AI_PROVIDER=openai
AI_API_KEY=your-api-key-here
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=500

OPENAI_API_KEY=
GEMINI_API_KEY=
STT_PROVIDER=mock

# =====================================================================
# TEXT-TO-SPEECH (TTS) CONFIGURATION: VoiceTut-TTS + Edge-TTS Fallback
# =====================================================================
# Primary provider: 'voicetut' (hosted on Hugging Face Spaces) or 'edge-tts'
TTS_PRIMARY_PROVIDER=voicetut

# Hugging Face Space URL or repo ID for VoiceTut-TTS
VOICETUT_SPACE_URL=https://huggingface.co/spaces/mohammedaly22/VoiceTut-TTS

# Male Egyptian Arabic voice selection: 'Ahmed', 'Karim', 'Ali', 'Hassan'
VOICETUT_VOICE=Ahmed

# Timeout in seconds before automatically triggering fallback
VOICETUT_TIMEOUT=12.0

# Optional Hugging Face Token to bypass anonymous rate limits and cold queue delays
# Get your token at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Automatic Fallback Voices (Edge-TTS)
EDGE_TTS_VOICE_PRIMARY=ar-EG-SalmaNeural
EDGE_TTS_VOICE_SECONDARY=ar-EG-ShakirNeural

# =====================================================================
# AI MARKETING STUDIO & SOCIAL MEDIA AUTO-PUBLISHING
# =====================================================================
# Google Gemini API for daily Arabic copywriting & visual prompts (Free tier supported)
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Cloudflare Workers AI for FLUX.1 Schnell image generation (Free tier: 10,000 neurons/day)
# Get credentials at https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Meta Graph API for Facebook Page Auto-Publishing
# Get Page ID & Page Access Token from Meta Developer Portal (https://developers.facebook.com/)
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_API_VERSION=v20.0
